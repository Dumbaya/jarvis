APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=jarvis
DB_USERNAME=jarvis
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

CORS_ALLOWED_ORIGINS=http://localhost:5173

# 자비스. GEMINI_API_KEY는 직접 입력하고 절대 Git에 올리지 않는다. 비어 있으면 규칙 기반 모드로 동작한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
JARVIS_INTERNAL_URL=http://nginx:8081

# 모델 단가(USD / 100만 토큰). 공식 가격표를 보고 직접 입력한다. 비워 두면 비용을 계산하지 않는다.
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=
# 월 예산(USD). 넘으면 AI 호출을 멈추고 키워드 검색으로 대체한다. 비우면 한도 없음. 모든 모델 단가가 있어야 적용된다.
JARVIS_MONTHLY_BUDGET_USD=

# 순서대로 시도할 "제공자/모델" 목록. 앞 모델의 한도가 소진되면 다음 모델로 넘어간다(무료 한도는 모델마다 따로다).
# 다른 제공자도 이어 붙일 수 있다: groq/<모델명>(GROQ_API_KEY), openrouter/<모델명>(OPENROUTER_API_KEY), ollama/<모델명>(키 없음)
JARVIS_LLM_CHAIN=gemini/gemini-3.5-flash,gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite
GROQ_API_KEY=
OPENROUTER_API_KEY=
