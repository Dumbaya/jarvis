# 운영 환경 설정 예시. 복사해서 .env.prod로 만들고 값을 채운다. .env.prod는 저장소에 올리지 않는다(.gitignore).
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# 이 파일은 두 곳에서 읽힌다: compose가 ${...} 치환에 쓰고(--env-file), 앱 컨테이너가 환경변수로 받는다(env_file).

# ── 서버(compose) ─────────────────────────────────────────────
# API 도메인. 인증서 경로(/etc/letsencrypt/live/<SERVER_NAME>/)와 일치해야 한다.
SERVER_NAME=api.example.com
HTTP_PORT=80
HTTPS_PORT=443
# 이 서버에서 빌드하지 않고 CI가 올린 이미지를 쓸 때 지정한다. 예: ghcr.io/<소유자>/jarvis-app:latest
# APP_IMAGE=

POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
# 반드시 길고 무작위인 값으로 바꾼다. 예: openssl rand -base64 32
POSTGRES_PASSWORD=

# ── 앱(Laravel) ───────────────────────────────────────────────
APP_NAME=Jarvis
APP_ENV=production
# 운영에서 true이면 오류 화면에 코드와 환경변수가 노출된다. 반드시 false.
APP_DEBUG=false
# docker run --rm -v "$PWD/backend:/app" -w /app composer:2 php artisan key:generate --show  (또는 로컬에서 생성)
APP_KEY=
APP_URL=https://api.example.com

# 컨테이너 로그로 보낸다(docker compose logs app).
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# 캐시, 세션, 큐는 DB를 쓴다(별도 Redis와 워커 프로세스가 필요 없다).
CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=sync

# 프런트(Vercel) 주소. 쉼표로 여러 개. 여기에 없는 출처의 브라우저 요청은 CORS로 막힌다.
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── 자비스(AI) ────────────────────────────────────────────────
JARVIS_TIMEZONE=Asia/Seoul
JARVIS_LLM_CHAIN=gemini/gemini-3.5-flash,gemini/gemini-3.5-flash-lite,gemini/gemini-3.1-flash-lite
# 한도 소진 시 키워드 검색으로 대체되므로 비워 두어도 서비스는 동작한다.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_MIN_SIMILARITY=0.6
# 모델 단가(USD/100만 토큰)와 월 예산. 비워 두면 비용은 "단가 미설정"으로 표시되고 예산 한도는 적용되지 않는다.
GEMINI_PRICE_INPUT_PER_M=
GEMINI_PRICE_OUTPUT_PER_M=
JARVIS_MONTHLY_BUDGET_USD=
EMBEDDING_RELATIVE_MARGIN=0.10
